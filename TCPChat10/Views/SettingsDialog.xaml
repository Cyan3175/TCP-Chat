<ContentDialog
    x:Class="TCPChat10.Views.SettingsDialog"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Title="设置"
    PrimaryButtonText="保存"
    CloseButtonText="取消"
    DefaultButton="Primary">

    <ScrollViewer VerticalScrollBarVisibility="Auto" MaxHeight="520">
        <StackPanel Spacing="14" Width="460">

            <TextBlock Text="服务器" FontWeight="SemiBold" />
            <TextBox x:Name="UrlBox" Header="WebDAV 地址" PlaceholderText="https://dev.zhaohans.cn" />
            <TextBox x:Name="FolderBox" Header="聊天目录"
                     PlaceholderText="nw集训/学生资料临存/聊天" />
            <TextBlock Text="消息会以 msg_*.json 的形式写入该目录；附件与消息同目录。目录不存在时会自动创建。"
                       FontSize="12" Opacity="0.65" TextWrapping="Wrap" />

            <TextBlock Text="身份" FontWeight="SemiBold" Margin="0,6,0,0" />
            <TextBox x:Name="NickBox" Header="昵称" PlaceholderText="显示在每条消息上" MaxLength="24" />

            <TextBlock Text="认证（可选，留空则匿名访问）" FontWeight="SemiBold" Margin="0,6,0,0" />
            <TextBox x:Name="UserBox" Header="用户名" PlaceholderText="留空 = 匿名" />
            <PasswordBox x:Name="PassBox" Header="密码" />

            <TextBlock Text="同步" FontWeight="SemiBold" Margin="0,6,0,0" />
            <NumberBox x:Name="PollBox" Header="同步间隔（秒）" Minimum="1" Maximum="120"
                       SpinButtonPlacementMode="Compact" />
            <NumberBox x:Name="DaysBox" Header="只显示最近几天的消息" Minimum="1" Maximum="365"
                       SpinButtonPlacementMode="Compact" />
            <CheckBox x:Name="AutoScrollBox" Content="新消息自动滚动到底部" />

            <TextBlock Text="外观" FontWeight="SemiBold" Margin="0,6,0,0" />
            <ComboBox x:Name="ThemeBox" Header="主题" HorizontalAlignment="Stretch">
                <ComboBoxItem Content="跟随系统" />
                <ComboBoxItem Content="浅色" />
                <ComboBoxItem Content="深色" />
            </ComboBox>

        </StackPanel>
    </ScrollViewer>
</ContentDialog>
