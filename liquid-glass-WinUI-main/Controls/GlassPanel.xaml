<UserControl
    x:Class="GlassEffectApp.Controls.GlassPanel"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d">

    <Border x:Name="GlassBorder"
            Width="300"
            Height="200"
            CornerRadius="28"
            Background="Transparent"
            BorderBrush="LightGray"
            BorderThickness="1"
            ManipulationMode="TranslateX,TranslateY"
            >
        
        <Border.BackgroundTransition>
            <BrushTransition Duration="0:0:0.2" />
        </Border.BackgroundTransition>
        
        <Border.Shadow>
            <ThemeShadow />
        </Border.Shadow>
        
        <Border.RenderTransform>
            <CompositeTransform x:Name="GlassTransform" />
        </Border.RenderTransform>
        
        <!-- Inner content area -->
        <Grid>
            <!-- Background blur effect layer -->
            <Border x:Name="BlurLayer"
                    CornerRadius="28"
                    Background="White"
                    Opacity="0.4" />
            
            <!-- Inner shadow simulation -->
            <Border x:Name="InnerShadowLayer"
                    CornerRadius="28"
                    Background="Transparent"
                    BorderBrush="White"
                    BorderThickness="2"
                    Opacity="0.7" />
        </Grid>
    </Border>
</UserControl>
