<Window
    x:Class="TCPChat10.Views.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:vm="using:TCPChat10.ViewModels"
    xmlns:canvas="using:Microsoft.Graphics.Canvas.UI.Xaml"
    Title="TCP Chat 11.5.1">

    <Grid x:Name="RootGrid" Background="{ThemeResource PageBrush}">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- 液态玻璃层(11.0): 底下铺背景图, 上面按注册的矩形画折射玻璃。
             它在最底层, 不接收输入; 关闭玻璃时整个隐藏, 界面回到普通主题色。 -->
        <canvas:CanvasControl x:Name="GlassCanvas" Grid.RowSpan="4"
                              IsHitTestVisible="False" Visibility="Collapsed"
                              ClearColor="Transparent" />

        <!-- 顶栏 -->
        <Border x:Name="TopBar" Grid.Row="0" Background="{ThemeResource PanelBrush}"
                BorderThickness="0,0,0,1" BorderBrush="{ThemeResource LineBrush}" Padding="14,10">
            <Grid ColumnSpacing="12">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <StackPanel Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                    <Image x:Name="AppMark" Width="22" Height="22" VerticalAlignment="Center" />
                    <TextBlock Text="TCP Chat 11.5.1" FontSize="16" FontWeight="SemiBold" VerticalAlignment="Center" />
                </StackPanel>

                <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                    <Ellipse x:Name="StatusDot" Width="9" Height="9" Fill="#9AA0A6" VerticalAlignment="Center" />
                    <TextBlock x:Name="HeaderStatus" FontSize="12" VerticalAlignment="Center"
                               Foreground="{ThemeResource MetaOtherBrush}" Text="正在连接…" />
                    <TextBlock x:Name="LockText" FontSize="12" VerticalAlignment="Center"
                               Foreground="{ThemeResource MetaOtherBrush}" Text="未加密" />
                </StackPanel>

                <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="8">
                    <TextBlock x:Name="MeText" VerticalAlignment="Center" FontSize="12"
                               Foreground="{ThemeResource MetaOtherBrush}" />
                    <Button x:Name="BtnWhoAmI" Content="改昵称" Click="OnChangeNickClick" />
                    <Button x:Name="BtnSettings" Content="设置" Click="OnSettingsClick" />
                </StackPanel>
            </Grid>
        </Border>

        <!-- 消息列表 -->
        <Grid x:Name="ListHost" Grid.Row="1" SizeChanged="OnListHostSizeChanged">
        <ListView x:Name="MessageList"
                  SelectionMode="None" Padding="14,10,14,26"
                  Background="Transparent"
                  ScrollViewer.HorizontalScrollMode="Disabled"
                  ScrollViewer.HorizontalScrollBarVisibility="Disabled">
            <ListView.ItemContainerStyle>
                <Style TargetType="ListViewItem">
                    <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                    <Setter Property="Padding" Value="0" />
                    <Setter Property="Margin" Value="0" />
                    <Setter Property="MinHeight" Value="0" />
                </Style>
            </ListView.ItemContainerStyle>
            <ListView.ItemTemplate>
                <DataTemplate x:DataType="vm:MessageVm">
                    <Grid HorizontalAlignment="{x:Bind Alignment}" Margin="{x:Bind BubbleMargin}"
                          MaxWidth="760" RightTapped="OnMessageRightTapped">
                        <StackPanel>
                            <!-- 11.4: 玻璃模式下这行底下垫一层跟主题走的衬底(关掉玻璃时是透明的) -->
                            <Border Background="{x:Bind MetaChipBrush, Mode=OneWay}"
                                    CornerRadius="6" Padding="6,1,6,1"
                                    HorizontalAlignment="{x:Bind Alignment}">
                            <StackPanel Orientation="Horizontal" Spacing="8"
                                        HorizontalAlignment="{x:Bind Alignment}">
                                <TextBlock Text="{x:Bind SenderText}" FontSize="{x:Bind SenderFontSize, Mode=OneWay}" FontWeight="SemiBold"
                                           Foreground="{x:Bind SenderBrush, Mode=OneWay}" />
                                <TextBlock Text="{x:Bind TimeText}" FontSize="{x:Bind MetaFontSize, Mode=OneWay}" VerticalAlignment="Center"
                                           Foreground="{x:Bind MetaBrush, Mode=OneWay}" />
                                <TextBlock Text="🔒" FontSize="{x:Bind MetaFontSize, Mode=OneWay}" VerticalAlignment="Center"
                                           Visibility="{x:Bind LockBadgeVisible}" />
                                <TextBlock Text="发送中…" FontSize="{x:Bind MetaFontSize, Mode=OneWay}" VerticalAlignment="Center"
                                           Foreground="{x:Bind MetaBrush, Mode=OneWay}" Visibility="{x:Bind PendingVisible, Mode=OneWay}" />
                                <TextBlock Text="{x:Bind StatusText}" FontSize="{x:Bind MetaFontSize, Mode=OneWay}" VerticalAlignment="Center"
                                           Foreground="{x:Bind StatusBrush, Mode=OneWay}" Visibility="{x:Bind HasStatus, Mode=OneWay}" />
                            </StackPanel>
                            </Border>

                            <Border x:Name="BubbleBorder" Background="{x:Bind BubbleBrush, Mode=OneWay}"
                                    CornerRadius="{x:Bind BubbleRadius}"
                                    Loaded="OnBubbleLoaded" Unloaded="OnBubbleUnloaded"
                                    Padding="12,9" Margin="0,3,0,0">
                                <StackPanel Spacing="7">
                                    <Border Visibility="{x:Bind HasQuote}" Background="{ThemeResource QuoteBrush}"
                                            CornerRadius="4" Padding="8,5" BorderThickness="3,0,0,0"
                                            BorderBrush="{ThemeResource AccentBrush}">
                                        <TextBlock Text="{x:Bind QuoteText}" TextWrapping="Wrap" FontSize="12"
                                                   Foreground="{x:Bind QuoteBrush, Mode=OneWay}" Opacity="0.9"
                                                   MaxLines="3" TextTrimming="CharacterEllipsis" />
                                    </Border>

                                    <!-- 图片 / 视频: 气泡里直接预览(视频用第一帧做缩略图), 点开用系统程序打开 -->
                                    <Grid Visibility="{x:Bind ImageVisible, Mode=OneWay}" HorizontalAlignment="Left">
                                        <Image Source="{x:Bind ImageSource, Mode=OneWay}"
                                               MaxHeight="300" MaxWidth="420" Stretch="Uniform"
                                               Tapped="OnImageTapped" />
                                        <Border Visibility="{x:Bind VideoBadgeVisible}" IsHitTestVisible="False"
                                                Width="38" Height="38" CornerRadius="19" Background="#A6000000"
                                                HorizontalAlignment="Center" VerticalAlignment="Center">
                                            <FontIcon FontFamily="Segoe MDL2 Assets" Glyph="&#xE768;" FontSize="15" Foreground="White" />
                                        </Border>
                                    </Grid>

                                    <!-- 普通文件 / 视频 / 音频: 文件卡片 -->
                                    <Border Visibility="{x:Bind CardVisible, Mode=OneWay}" Background="{x:Bind AttachBrush, Mode=OneWay}"
                                            CornerRadius="8" Padding="10,8" Tapped="OnCardTapped">
                                        <StackPanel Orientation="Horizontal" Spacing="10">
                                            <TextBlock Text="{x:Bind AttachGlyph}" FontSize="20" VerticalAlignment="Center" />
                                            <StackPanel VerticalAlignment="Center">
                                                <TextBlock Text="{x:Bind AttachName}" FontSize="13" TextWrapping="NoWrap"
                                                           TextTrimming="CharacterEllipsis" MaxWidth="300"
                                                           Foreground="{x:Bind BodyBrush, Mode=OneWay}" />
                                                <TextBlock Text="{x:Bind AttachSizeText}" FontSize="11" Opacity="0.8"
                                                           Foreground="{x:Bind BodyBrush, Mode=OneWay}" />
                                            </StackPanel>
                                        </StackPanel>
                                    </Border>

                                    <!-- 语音: 播放按钮 + 时长 -->
                                    <Border Visibility="{x:Bind VoiceVisible}" Background="{x:Bind AttachBrush, Mode=OneWay}"
                                            CornerRadius="16" Padding="5,4">
                                        <StackPanel Orientation="Horizontal" Spacing="8">
                                            <Button Click="OnVoicePlayClick" Width="32" Height="32" Padding="0" CornerRadius="16"
                                                    Background="{x:Bind BodyBrush, Mode=OneWay}" BorderThickness="0">
                                                <FontIcon FontFamily="Segoe MDL2 Assets" FontSize="13"
                                                          Glyph="{x:Bind VoiceGlyph, Mode=OneWay}"
                                                          Foreground="{x:Bind VoiceIconBrush, Mode=OneWay}" />
                                            </Button>
                                            <TextBlock Text="{x:Bind PlayRowText}" VerticalAlignment="Center"
                                                       FontSize="13" MinWidth="28"
                                                       TextTrimming="CharacterEllipsis" MaxWidth="260"
                                                       Foreground="{x:Bind BodyBrush, Mode=OneWay}"
                                                       ToolTipService.ToolTip="{x:Bind VoiceHint, Mode=OneWay}" />
                                        </StackPanel>
                                    </Border>

                                    <!-- 正文: 交给 markdown 渲染器(纯文本时就是一个 TextBlock) -->
                                    <ContentPresenter Content="{x:Bind Body, Mode=OneWay}"
                                                      Visibility="{x:Bind HasBody}" />
                                </StackPanel>
                            </Border>
                        </StackPanel>
                    </Grid>
                </DataTemplate>
            </ListView.ItemTemplate>
        </ListView>
        </Grid>

        <!-- 输入区 -->
        <Border x:Name="InputBar" Grid.Row="2" Background="{ThemeResource PanelBrush}"
                BorderThickness="0,1,0,0" BorderBrush="{ThemeResource LineBrush}" Padding="14,10">
            <Grid ColumnSpacing="8">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <Button x:Name="BtnAttach" Content="📎 文件" Click="OnAttachClick"
                        VerticalAlignment="Bottom" Height="40" />
                <Button x:Name="BtnVoice" Grid.Column="1" Content="🎤 语音" Click="OnVoiceClick"
                        VerticalAlignment="Bottom" Height="40" />
                <TextBox x:Name="InputBox" Grid.Column="2" MinHeight="40" MaxHeight="170"
                         PlaceholderText="输入消息   Enter 发送 · Shift+Enter / Ctrl+Enter 换行"
                         AcceptsReturn="True" TextWrapping="Wrap"
                         VerticalAlignment="Bottom" PreviewKeyDown="OnInputPreviewKeyDown" />
                <Button x:Name="BtnSend" Grid.Column="3" Content="发送" Click="OnSendClick"
                        VerticalAlignment="Bottom" Height="40" MinWidth="84"
                        Style="{StaticResource AccentButtonStyle}" />
            </Grid>
        </Border>

        <!-- 状态栏 -->
        <Border x:Name="FooterBar" Grid.Row="3" Background="{ThemeResource PanelBrush}"
                BorderThickness="0,1,0,0" BorderBrush="{ThemeResource LineBrush}" Padding="14,6">
            <Grid>
                <TextBlock x:Name="FooterText" FontSize="12" TextTrimming="CharacterEllipsis"
                           Foreground="{ThemeResource MetaOtherBrush}" Text="就绪" />
                <ProgressRing x:Name="BusyRing" Width="16" Height="16" IsActive="false"
                              HorizontalAlignment="Right" />
            </Grid>
        </Border>
    </Grid>
</Window>
