<ContentDialog
    x:Class="TCPChat10.Views.SettingsDialog"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="using:TCPChat10.Controls"
    Title="设置"
    PrimaryButtonText="保存"
    CloseButtonText="取消"
    DefaultButton="Primary"
    CornerRadius="16">

    <!-- 圆角: 对话框模板用的是 OverlayCornerRadius, 这里调大一点 -->
    <ContentDialog.Resources>
        <CornerRadius x:Key="OverlayCornerRadius">16</CornerRadius>
    </ContentDialog.Resources>

    <ScrollViewer x:Name="SettingsScroll" VerticalScrollBarVisibility="Auto" MaxHeight="560">
        <StackPanel Spacing="14" Width="460">

            <TextBlock Text="服务器" FontWeight="SemiBold" />
            <TextBox x:Name="UrlBox" Header="WebDAV 地址" PlaceholderText="https://dev.zhaohans.cn" />
            <TextBox x:Name="FolderBox" Header="聊天目录"
                     PlaceholderText="nw集训/学生资料临存/聊天" />
            <TextBlock Text="消息会以 msg_*.json 的形式直接写进这个目录（不会另建子文件夹），所以目录要事先在服务器上存在。"
                       FontSize="12" Opacity="0.65" TextWrapping="Wrap" />

            <TextBlock Text="身份" FontWeight="SemiBold" Margin="0,6,0,0" />
            <TextBox x:Name="NickBox" Header="昵称" PlaceholderText="显示在每条消息上" MaxLength="24" />

            <TextBlock Text="端到端加密" FontWeight="SemiBold" Margin="0,6,0,0" />
            <TextBox x:Name="CryptoListBox" Header="密码列表（每行一个，收消息时按顺序依次尝试）"
                     AcceptsReturn="True" TextWrapping="NoWrap" Height="92"
                     FontFamily="Consolas" PlaceholderText="每行一个密码&#x0a;第 1 行优先尝试" />
            <ComboBox x:Name="SendPasswordBox" Header="默认用哪一个加密发送" HorizontalAlignment="Stretch" />
            <TextBlock x:Name="CryptoError" FontSize="12" Foreground="#D9534F" TextWrapping="Wrap"
                       Visibility="Collapsed" Text="密码列表里有空行，或者没有可用的密码。" />
            <TextBlock FontSize="12" Opacity="0.65" TextWrapping="Wrap"
                       Text="列表留空 = 不加密（正文以明文写在服务器上）。填了密码后，正文与引用会用 AES-256-GCM 加密后再上传；收消息时会把列表里的密码从选中的那把开始依次尝试，解不开才显示“无法解密”。注意：列表里任何一把都能解开用它加密的历史消息，整体强度等于最弱的那把 —— 只建议“换过密码、还想读老消息”时这么用。这些密码只用于消息内容，和服务器账号密码是两回事。" />

            <TextBlock Text="同步" FontWeight="SemiBold" Margin="0,6,0,0" />
            <NumberBox x:Name="PollBox" Header="同步间隔（秒）" Minimum="1" Maximum="120"
                       SpinButtonPlacementMode="Compact" />
            <NumberBox x:Name="DaysBox" Header="只显示最近几天的消息" Minimum="1" Maximum="365"
                       SpinButtonPlacementMode="Compact" />
            <CheckBox x:Name="AutoScrollBox" Content="新消息自动滚动到底部" />

            <TextBlock Text="外观" FontWeight="SemiBold" Margin="0,6,0,0" />
            <ComboBox x:Name="ThemeBox" Header="主题" HorizontalAlignment="Stretch">
                <ComboBoxItem Content="跟随系统" />
                <ComboBoxItem Content="浅色" />
                <ComboBoxItem Content="深色" />
            </ComboBox>
            <ComboBox x:Name="FontBox" Header="字体（列表实时预览）" HorizontalAlignment="Stretch" />
            <TextBlock Text="字体列表来自本机已安装的字体，选完保存即生效并写进设置文件，下次启动照旧。"
                       FontSize="12" Opacity="0.65" TextWrapping="Wrap" />

            <TextBlock Text="液态玻璃" FontWeight="SemiBold" Margin="0,6,0,0" />
            <Grid ColumnSpacing="12">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <!-- 液态玻璃的开关和滑块本身就是玻璃控件(和主界面同一套 Win2D 效果链) -->
                <controls:GlassSwitch x:Name="GlassSwitch" VerticalAlignment="Center" />
                <TextBlock Grid.Column="1" Text="开启液态玻璃（11.0）" VerticalAlignment="Center" />
            </Grid>
            <StackPanel Spacing="4">
                <Grid ColumnSpacing="8">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <TextBlock Text="质量（湍流层数 / 模糊 / 色彩增强 / 渲染分辨率）" FontSize="13"
                               VerticalAlignment="Center" TextWrapping="Wrap" />
                    <TextBlock x:Name="GlassQualityText" Grid.Column="1" FontSize="13" FontWeight="SemiBold"
                               VerticalAlignment="Center" MinWidth="34" TextAlignment="Right" />
                </Grid>
                <controls:GlassSlider x:Name="GlassQualitySlider" Minimum="0" Maximum="100" />
                <TextBlock x:Name="GlassHint" FontSize="12" Opacity="0.65" TextWrapping="Wrap"
                           Text="背景用系统的桌面壁纸（读不到就程序生成一张），面板/气泡按折射玻璃绘制。质量越低越省 GPU。" />
            </StackPanel>

        </StackPanel>
    </ScrollViewer>
</ContentDialog>
