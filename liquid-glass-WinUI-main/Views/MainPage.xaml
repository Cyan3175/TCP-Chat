<Page
    x:Class="GlassEffectApp.Views.MainPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:local="using:GlassEffectApp"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:canvas="using:Microsoft.Graphics.Canvas.UI.Xaml"
    mc:Ignorable="d">
    
    <Grid>
        <!-- Background Image -->
        <Border x:Name="BackgroundContainer">
            <Border.Background>
                <ImageBrush x:Name="BackgroundImage" ImageSource="ms-appx:///Assets/home.jpg" Stretch="UniformToFill" />
            </Border.Background>
        </Border>

        <!-- Glass Panel with Win2D -->
        <Canvas x:Name="GlassCanvas">
            <!-- Win2D Canvas for liquid glass effects with XAML-level clipping -->
            <canvas:CanvasControl x:Name="LiquidGlassCanvas"
                                Canvas.Left="200" 
                                Canvas.Top="150"
                                Width="300"
                                Height="200"
                                Draw="OnLiquidGlassDraw"
                                CreateResources="OnCreateResources"
                                PointerPressed="OnGlassPanelPointerPressed"
                                PointerMoved="OnGlassPanelPointerMoved"
                                PointerReleased="OnGlassPanelPointerReleased"
                                Background="Transparent">
                <canvas:CanvasControl.Clip>
                    <RectangleGeometry Rect="0,0,300,200"/>
                </canvas:CanvasControl.Clip>
            </canvas:CanvasControl>
        </Canvas>

        <!-- Control Panel (similar to HTML controls) -->
        <Border x:Name="ControlPanel"
                HorizontalAlignment="Left"
                VerticalAlignment="Top"
                Margin="10"
                Background="#99000000"
                CornerRadius="8"
                Padding="12"
                MaxWidth="280"
                MaxHeight="600">
            
            <ScrollViewer VerticalScrollBarVisibility="Auto">
                <StackPanel Spacing="12">
                    
                    <!-- Inner Shadow Section -->
                    <StackPanel Spacing="8">
                        <TextBlock Text="Inner Shadow" 
                                  FontWeight="SemiBold" 
                                  FontSize="16" 
                                  Foreground="White" />
                        
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <TextBlock Text="Color:" 
                                      VerticalAlignment="Center" 
                                      MinWidth="80" 
                                      Foreground="White" />
                            <Button x:Name="ShadowColorButton" 
                                   Background="White"
                                   Width="30" Height="30" 
                                   CornerRadius="4"
                                   Click="OnShadowColorClick" />
                        </StackPanel>
                        
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <TextBlock Text="Blur:" 
                                      VerticalAlignment="Center" 
                                      MinWidth="80" 
                                      Foreground="White" />
                            <Slider x:Name="ShadowBlurSlider" 
                                   Minimum="0" Maximum="20" Value="20"
                                   Width="140"
                                   ValueChanged="OnShadowBlurChanged" />
                            <TextBlock x:Name="ShadowBlurText" 
                                      Text="20px" 
                                      VerticalAlignment="Center" 
                                      Foreground="White" />
                        </StackPanel>
                        
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <TextBlock Text="Spread:" 
                                      VerticalAlignment="Center" 
                                      MinWidth="80" 
                                      Foreground="White" />
                            <Slider x:Name="ShadowSpreadSlider" 
                                   Minimum="-10" Maximum="10" Value="-5"
                                   Width="140"
                                   ValueChanged="OnShadowSpreadChanged" />
                            <TextBlock x:Name="ShadowSpreadText" 
                                      Text="-5px" 
                                      VerticalAlignment="Center" 
                                      Foreground="White" />
                        </StackPanel>
                    </StackPanel>

                    <!-- Glass Tint Section -->
                    <StackPanel Spacing="8">
                        <TextBlock Text="Glass Tint" 
                                  FontWeight="SemiBold" 
                                  FontSize="16" 
                                  Foreground="White" />
                        
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <TextBlock Text="Tint Color:" 
                                      VerticalAlignment="Center" 
                                      MinWidth="80" 
                                      Foreground="White" />
                            <Button x:Name="TintColorButton" 
                                   Background="White"
                                   Width="30" Height="30" 
                                   CornerRadius="4"
                                   Click="OnTintColorClick" />
                        </StackPanel>
                        
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <TextBlock Text="Opacity:" 
                                      VerticalAlignment="Center" 
                                      MinWidth="80" 
                                      Foreground="White" />
                            <Slider x:Name="TintOpacitySlider" 
                                   Minimum="0" Maximum="100" Value="0"
                                   Width="140"
                                   ValueChanged="OnTintOpacityChanged" />
                            <TextBlock x:Name="TintOpacityText" 
                                      Text="0%" 
                                      VerticalAlignment="Center" 
                                      Foreground="White" />
                        </StackPanel>
                    </StackPanel>

                    <!-- Frost Blur Section -->
                    <StackPanel Spacing="8">
                        <TextBlock Text="Frost Blur" 
                                  FontWeight="SemiBold" 
                                  FontSize="16" 
                                  Foreground="White" />
                        
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <TextBlock Text="Blur Radius:" 
                                      VerticalAlignment="Center" 
                                      MinWidth="80" 
                                      Foreground="White" />
                            <Slider x:Name="FrostBlurSlider" 
                                   Minimum="0" Maximum="30" Value="2"
                                   Width="140"
                                   ValueChanged="OnFrostBlurChanged" />
                            <TextBlock x:Name="FrostBlurText" 
                                      Text="2px" 
                                      VerticalAlignment="Center" 
                                      Foreground="White" />
                        </StackPanel>
                    </StackPanel>

                    <!-- Noise Distortion Section -->
                    <StackPanel Spacing="8">
                        <TextBlock Text="Noise Distortion" 
                                  FontWeight="SemiBold" 
                                  FontSize="16" 
                                  Foreground="White" />
                        
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <TextBlock Text="Noise Freq:" 
                                      VerticalAlignment="Center" 
                                      MinWidth="80" 
                                      Foreground="White" />
                            <Slider x:Name="NoiseFreqSlider" 
                                   Minimum="0" Maximum="0.02" Value="0.008"
                                   Width="140"
                                   StepFrequency="0.001"
                                   ValueChanged="OnNoiseFreqChanged" />
                            <TextBlock x:Name="NoiseFreqText" 
                                      Text="0.008" 
                                      VerticalAlignment="Center" 
                                      Foreground="White" />
                        </StackPanel>
                        
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <TextBlock Text="Strength:" 
                                      VerticalAlignment="Center" 
                                      MinWidth="80" 
                                      Foreground="White" />
                            <Slider x:Name="DistortionStrengthSlider" 
                                   Minimum="0" Maximum="200" Value="77"
                                   Width="140"
                                   ValueChanged="OnDistortionStrengthChanged" />
                            <TextBlock x:Name="DistortionStrengthText" 
                                      Text="77" 
                                      VerticalAlignment="Center" 
                                      Foreground="White" />
                        </StackPanel>
                    </StackPanel>

                    <!-- Background Image Section -->
                    <StackPanel Spacing="8">
                        <TextBlock Text="Background Image" 
                                  FontWeight="SemiBold" 
                                  FontSize="16" 
                                  Foreground="White" />
                        
                        <TextBox x:Name="BackgroundUrlTextBox" 
                                PlaceholderText="Image URL..."
                                Width="250"
                                Height="32"
                                Background="White"
                                KeyDown="OnBackgroundUrlKeyDown" />
                        
                        <Button Content="Apply URL" 
                               Click="OnApplyBackgroundClick" 
                               HorizontalAlignment="Stretch"
                               Background="#66FFFFFF"
                               Foreground="Black" />
                        
                        <Button Content="Reset to Local Image" 
                               Click="OnResetBackgroundClick" 
                               HorizontalAlignment="Stretch"
                               Background="#66FFFFFF"
                               Foreground="Black" />
                    </StackPanel>
                    
                </StackPanel>
            </ScrollViewer>
        </Border>
    </Grid>
</Page>
