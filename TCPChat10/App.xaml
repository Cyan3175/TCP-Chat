<Application
    x:Class="TCPChat10.App"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Application.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <XamlControlsResources xmlns="using:Microsoft.UI.Xaml.Controls" />
            </ResourceDictionary.MergedDictionaries>

            <!-- 对话框/弹出层圆角(默认 8, 这里给大一点) -->
            <CornerRadius x:Key="OverlayCornerRadius">16</CornerRadius>

            <ResourceDictionary.ThemeDictionaries>
                <ResourceDictionary x:Key="Light">
                    <SolidColorBrush x:Key="PageBrush" Color="#F3F3F3" />
                    <SolidColorBrush x:Key="PanelBrush" Color="#FFFFFF" />
                    <SolidColorBrush x:Key="LineBrush" Color="#1A000000" />
                    <SolidColorBrush x:Key="BubbleOtherBrush" Color="#FFFFFF" />
                    <SolidColorBrush x:Key="BodyOtherBrush" Color="#1B1B1B" />
                    <SolidColorBrush x:Key="MetaOtherBrush" Color="#99000000" />
                    <SolidColorBrush x:Key="ErrorBrush" Color="#C0392B" />
                    <Color x:Key="BubbleSelfColor">#2B6CB0</Color>
                    <SolidColorBrush x:Key="AccentBrush" Color="#2B6CB0" />
                    <!-- 11.4 液态玻璃: 昵称/时间画在壁纸上, 给一层浅衬底 + 更深的字色, 才不会糊在背景里 -->
                    <SolidColorBrush x:Key="MetaChipBrush" Color="#D1FFFFFF" />
                    <SolidColorBrush x:Key="SenderGlassBrush" Color="#17497F" />
                    <SolidColorBrush x:Key="MetaGlassBrush" Color="#B3000000" />
                    <SolidColorBrush x:Key="QuoteBrush" Color="#0F000000" />
                </ResourceDictionary>
                <ResourceDictionary x:Key="Dark">
                    <SolidColorBrush x:Key="PageBrush" Color="#1B1B1F" />
                    <SolidColorBrush x:Key="PanelBrush" Color="#25252B" />
                    <SolidColorBrush x:Key="LineBrush" Color="#22FFFFFF" />
                    <SolidColorBrush x:Key="BubbleOtherBrush" Color="#32323A" />
                    <SolidColorBrush x:Key="BodyOtherBrush" Color="#EDEDF2" />
                    <SolidColorBrush x:Key="MetaOtherBrush" Color="#B8FFFFFF" />
                    <SolidColorBrush x:Key="ErrorBrush" Color="#FF9E9E" />
                    <Color x:Key="BubbleSelfColor">#3E7CC7</Color>
                    <SolidColorBrush x:Key="AccentBrush" Color="#7FB2E5" />
                    <!-- 11.4 液态玻璃: 同上, 深色下用深衬底 + 更亮的字色 -->
                    <SolidColorBrush x:Key="MetaChipBrush" Color="#C2000000" />
                    <SolidColorBrush x:Key="SenderGlassBrush" Color="#A9CDF2" />
                    <SolidColorBrush x:Key="MetaGlassBrush" Color="#D9FFFFFF" />
                    <SolidColorBrush x:Key="QuoteBrush" Color="#18FFFFFF" />
                </ResourceDictionary>
            </ResourceDictionary.ThemeDictionaries>
        </ResourceDictionary>
    </Application.Resources>
</Application>
